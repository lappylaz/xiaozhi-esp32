# Append after upstream ESP32-S3 defaults. No credentials are compiled in.
CONFIG_BOARD_TYPE_XORIGIN_AIPI_LITE=y
CONFIG_SABRINA_VOICE=y
CONFIG_WAKE_WORD_DISABLED=y
CONFIG_USE_AUDIO_PROCESSOR=y
CONFIG_USE_DEVICE_AEC=n
CONFIG_USE_SERVER_AEC=n
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_ESP_TLS_INSECURE=n
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=n
